#!/bin/sh
#
# @name InDro Skywalker X8
#
# @type Flying Wing
# @class Plane
#
# @maintainer Calvin Rubens <calvin.rubens@indrorobotics.com>
#

. ${R}etc/init.d/rc.fw_defaults

# GEOMETRY
param set-default CA_AIRFRAME 1
param set-default CA_ROTOR_COUNT 1
param set-default CA_SV_CS_COUNT 2
param set-default CA_SV_CS0_TRQ_P 0.5
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS0_TYPE 5
param set-default CA_SV_CS1_TRQ_P 0.5
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS1_TYPE 6

# COMMS
# No Ethernet MAVLink: the ground station reaches the vehicle over TELEM1 and through mavlink-router on the companion.
param set-default MAV_2_CONFIG 0
param set-default MAV_0_FLOW_CTRL 0
param set-default MAV_0_RATE 0
param set-default SER_TEL1_BAUD 115200
param set-default SER_TEL2_BAUD 3000000
param set-default UXRCE_DDS_CFG 102
param set-default UXRCE_DDS_DOM_ID 0
param set-default UXRCE_DDS_PTCFG 1

# SENSORS
param set-default ASPD_FALLBACK 1
param set-default SYS_HAS_NUM_DIST 1

# UAVCAN
param set-default UAVCAN_ENABLE 2
param set-default UAVCAN_RNG_MAX 50.0
param set-default UAVCAN_RNG_MIN 0.08
param set-default UAVCAN_SUB_DPRES 1
param set-default UAVCAN_SUB_RNG 1

# EKF2
# A quality hold longer than the 1 s terrain timeout aborts a mission landing on one bad range sample.
param set-default EKF2_RNG_QLTY_T 0.2

# COM
param set-default COM_ARM_SDCARD 2
param set-default COM_BAT_DISC_T 2.0
param set-default COM_LOW_BAT_ACT 3
param set-default COM_PREARM_MODE 2
param set-default COM_RC_IN_MODE 0
param set-default COM_RC_LOSS_T 2.0
param set-default GF_ACTION 3
param set-default GF_MAX_HOR_DIST 500
param set-default GF_MAX_VER_DIST 60
param set-default NAV_DLL_ACT 2

# NAV
# Flight at 30 m; the fence sits at 60 m so a gust or a turn does not trip it.
# A landing abort climbs this far above the height it starts from.
param set-default MIS_LND_ABRT_ALT 20
param set-default MIS_TAKEOFF_ALT 30
param set-default RTL_DESCEND_ALT 30
param set-default RTL_RETURN_ALT 30

# RC
param set-default RC_SBUS_PRT_CFG 300

# FW
param set-default FW_AIRSPD_MAX 26.0
param set-default FW_AIRSPD_MIN 15.0
param set-default FW_AIRSPD_STALL 11.0
param set-default FW_AIRSPD_TRIM 18.0
param set-default FW_P_LIM_MAX 30.0
param set-default FW_R_LIM 50.0
param set-default FW_WING_HEIGHT 0.1
# Climb rate held low until a full-throttle climb is measured.
param set-default FW_T_CLMB_MAX 3.0
param set-default FW_WING_SPAN 2.12
param set-default WEIGHT_BASE 4.5
param set-default WEIGHT_GROSS 4.5

# LAUNCH
param set-default FW_LAUN_AC_T 0.1
param set-default FW_LAUN_AC_THLD 20.0
param set-default FW_LAUN_DETCN_ON 1
param set-default FW_LAUN_MOT_DEL 0.5
# Pusher stopped on the launcher and commanded to zero in the flare.
param set-default FW_THR_IDLE 0.0

# LAND
param set-default FW_LND_FL_PMAX 15.0
param set-default FW_LND_FL_TIME 0.5
param set-default FW_LND_FLALT 1.0
# The pitot reads wind on the parked wing.
param set-default LNDFW_AIRSPD_MAX 8.0

# AUX
param set-default PWM_AUX_DIS1 1500
param set-default PWM_AUX_DIS2 1500
param set-default PWM_AUX_FUNC1 201
param set-default PWM_AUX_FUNC2 202
param set-default PWM_AUX_FUNC5 101
param set-default PWM_AUX_TIM0 50

# POWER
# Cruise current of one pack, seeds the remaining-time estimate.
param set-default BAT_AVRG_CURRENT 5
param set-default BAT_CRIT_THR 0.15
param set-default BAT_EMERGEN_THR 0.08
param set-default BAT_LOW_THR 0.25
# 6S Li-ion packs, 4500 mAh each.
param set-default BAT1_CAPACITY 4500
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_CHARGED 4.15
param set-default BAT1_V_EMPTY 3.3
param set-default BAT2_CAPACITY 4500
param set-default BAT2_N_CELLS 6
param set-default BAT2_V_CHARGED 4.15
param set-default BAT2_V_EMPTY 3.3
param set-default BAT2_SOURCE 0
param set-default INA238_SHUNT 0.0001
param set-default SENS_EN_INA226 0
param set-default SENS_EN_INA238 1

# LOGGING
param set-default SDLOG_DIRS_MAX 30
