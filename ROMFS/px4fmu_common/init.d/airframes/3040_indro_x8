#!/bin/sh
#
# @name InDro Skywalker X8
#
# @type Flying Wing
# @class Plane
#
# @maintainer Calvin Rubens <calvin.rubens@indrorobotics.com>
#

. ${R}etc/init.d/rc.fw_defaults

# GEOMETRY
param set-default CA_AIRFRAME 1
param set-default CA_ROTOR_COUNT 1
param set-default CA_SV_CS_COUNT 2
param set-default CA_SV_CS0_TRQ_P 0.5
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS0_TYPE 5
param set-default CA_SV_CS1_TRQ_P 0.5
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS1_TYPE 6

# COMMS
# No Ethernet MAVLink: the ground station reaches the vehicle over TELEM1 and through mavlink-router on the companion.
param set-default MAV_2_CONFIG 0
param set-default MAV_0_FLOW_CTRL 0
param set-default MAV_0_RATE 0
param set-default SER_TEL1_BAUD 115200
param set-default SER_TEL2_BAUD 3000000
param set-default UXRCE_DDS_CFG 102
param set-default UXRCE_DDS_DOM_ID 0
param set-default UXRCE_DDS_PTCFG 1

# SENSORS
param set-default SENS_BOARD_ROT 14
param set-default ASPD_FALLBACK 1
param set-default SYS_HAS_NUM_DIST 1

# UAVCAN
param set-default UAVCAN_ENABLE 2
param set-default UAVCAN_RNG_MAX 50.0
param set-default UAVCAN_RNG_MIN 0.08
param set-default UAVCAN_RDR_MAX 100.0
param set-default UAVCAN_RDR_MIN 0.5
param set-default UAVCAN_SUB_DPRES 1
param set-default UAVCAN_SUB_RNG 1

# EKF2
# Range data counts again 0.2 s after a bad sample: the flare height comes from it.
param set-default EKF2_RNG_QLTY_T 0.2

# COM
param set-default COM_ARM_MIS_REQ 1
# Return on the thrust loss flag: the glide heads for the landing pattern.
param set-default COM_ACT_FAIL_ACT 3
param set-default COM_ARM_SDCARD 2
param set-default COM_BAT_DISC_T 2.0
# A failsafe acts at once: a Hold on final loiters near the ground.
param set-default COM_FAIL_ACT_T 0
# Return at emergency battery too: Land circles down wherever the wing is.
param set-default COM_LOW_BAT_ACT 1
param set-default COM_PREARM_MODE 2
param set-default COM_RC_IN_MODE 0
param set-default COM_RC_LOSS_T 2.0
param set-default GF_ACTION 3
param set-default GF_MAX_HOR_DIST 500
param set-default GF_MAX_VER_DIST 60
param set-default NAV_DLL_ACT 2

# FAILURE DETECTOR
# ESC current check off: its flag holds full throttle in auto modes and does not clear in flight.
param set-default FD_ACT_EN 0
# Thrust loss check on: gust deficits at full throttle last up to 1.8 s, and a cruise loss flags within 6 s.
param set-default FD_FW_TL_TIME 2.2
# Thrust is expected from this throttle up.
param set-default FD_FW_TL_THR 0.7
# At -0.5 m/s a gust deficit lasts as long as the check time.
param set-default FD_FW_TL_RATE -0.8

# NAV
# Takeoff holds at 45 m and Return at 30 m; the fence sits at 60 m.
# Arming replaces a stored landing pattern that does not fit with one written from home on the compass heading: a heading bent by the launcher rail turns the pattern about home, so check the heading at the ground station against the rail before arming.
param set-default MIS_LP_EN 1
# Written touchdown 15 m ahead of home on the launch heading.
param set-default MIS_LP_AHEAD 15
# Written touchdown 6 m right of the launch line.
param set-default MIS_LP_OFFSET 6
# Written final of 200 m from the orbit exit.
param set-default MIS_LP_DIST 200
# Written orbit at 22 m: over the 200 m final a 6.28 deg slope, inside FW_LND_ANG.
param set-default MIS_LP_ALT 22
param set-default MIS_TAKEOFF_ALT 45
# Arming is refused on a mission without a landing.
param set-default MIS_TKO_LAND_REQ 2
# The approach orbit exits within 2 m of its height, so the final starts on the glide slope.
param set-default NAV_FW_ALTL_RAD 2
param set-default NAV_LOITER_RAD 60
param set-default RTL_DESCEND_ALT 30
# Return to home or a rally point lands instead of loitering.
param set-default RTL_LAND_DELAY 0
param set-default RTL_LOITER_RAD 60
param set-default RTL_RETURN_ALT 30
# Return flies the stored landing pattern.
param set-default RTL_TYPE 1

# RC
param set-default RC_SBUS_PRT_CFG 300

# FW
# The airframe manual limits speed to 85 km/h above 3.2 kg.
param set-default FW_AIRSPD_MAX 23.0
param set-default FW_AIRSPD_MIN 14.0
param set-default FW_AIRSPD_STALL 10.5
param set-default FW_AIRSPD_TRIM 18.0
param set-default FW_P_LIM_MAX 30.0
# Stock wings at 3.78 kg, 18 % over the airframe limit: pull-ups held near 2 g.
param set-default FW_P_RMAX_NEG 30.0
param set-default FW_P_RMAX_POS 30.0
param set-default FW_R_LIM 50.0
# Wings held level below 3.5 m: the roll-out from an orbit bank takes that height at landing sink.
param set-default FW_WING_HEIGHT 3.5
# Climb rate held low until a full-throttle climb is measured.
param set-default FW_T_CLMB_MAX 3.0
param set-default FW_T_HRATE_FF 0.7
param set-default FW_T_THR_LOW_HGT 30
# Glide reach per metre of height: a setpoint farther away raises the wings-level height.
param set-default FW_TL_GLIDE 8
# Wings level below 20 m after a thrust loss: the 22 m pattern orbit stays free to turn.
param set-default FW_TL_LVL_ALT 20
param set-default FW_WING_SPAN 2.12
param set-default WEIGHT_BASE 3.78
param set-default WEIGHT_GROSS 3.78

# LAUNCH
param set-default FW_LAUN_AC_T 0.1
# Launch detected from 15 m/s/s: at 20 a shot of two band runs at 50 % loss goes undetected.
param set-default FW_LAUN_AC_THLD 15
# Takeoff course from the GNSS track over 20 m.
param set-default FW_LAUN_CRS_DST 20
param set-default FW_LAUN_DETCN_ON 1
param set-default FW_LAUN_MOT_DEL 0.4
# Launch gate at 2.5 m/s until three logged launches show the decision speed within 1.0 m/s of the exit speed.
param set-default FW_LAUN_SPD_MIN 2.5
# Takeoff pitch flies FW_TKO_AIRSPD alone: a weak motor costs climb rate before airspeed.
param set-default FW_TKO_SPDWT 2
# Takeoff pitch floor at FW_TKO_PMIN_REL above 5 m: a motor that stops in the climb pitches down for FW_TKO_AIRSPD.
param set-default FW_TKO_PMIN_ALT 5
# At a 4 deg floor a motor cut in the climb glides at 11 m/s or more.
param set-default FW_TKO_PMIN_REL 4
# Pusher stopped on the launcher and commanded to zero in the flare.
param set-default FW_THR_IDLE 0.0

# LAND
# No abort on a terrain timeout: an aborted landing loiters until commanded.
param set-default FW_LND_ABORT 1
param set-default FW_LND_AIRSPD 14
param set-default FW_LND_ANG 6.3
param set-default FW_LND_EARLYCFG 1
# Flare pitch stays under 4.5 deg: above it a wingtip touches first at gust roll.
param set-default FW_LND_FL_PMAX 4
param set-default FW_LND_FL_PMIN 4
param set-default FW_LND_FL_TIME 0.3
# Stock flare trigger.
param set-default FW_LND_FL_TTD 0
param set-default FW_LND_FLALT 1.5
# The approach holds the glide slope ahead of the airspeed, so the flare starts on the slope.
param set-default FW_LND_SPDWT 0.5
param set-default FW_LND_THRTC_SC 0.2
# No headwind additive.
param set-default FW_LND_WIND_SC 0
# The pitot reads wind on the parked wing.
param set-default LNDFW_AIRSPD_MAX 8.0

# SOARING
# Off: the 60 m fence leaves no height band, and no thermal has been flown on the aircraft.
param set-default SOAR_ENABLE 0
# Glide polar of the wing at 3.78 kg: sink 1.42 m/s at 14 m/s.
param set-default SOAR_POLAR_CD0 0.0297
param set-default SOAR_POLAR_B 0.0702
param set-default SOAR_POLAR_K 80.2
# Heights above home of the motor restart, the motor cut and the ceiling.
param set-default SOAR_ALT_MIN 100
param set-default SOAR_ALT_CUTOFF 250
param set-default SOAR_ALT_MAX 400
# 35 deg flies a 35 m circle at 15.5 m/s.
param set-default SOAR_THML_BANK 35
# Thermalling circles stay 150 m inside the fence.
param set-default SOAR_MAX_RADIUS 350
# The thermal estimate leans with the wind over a base fixed to the ground.
param set-default SOAR_DRIFT 0

# TERRAIN FOLLOW
# Off: the follow bits act only when set in flight, and the guard bit waits for its regression flights.
param set-default FW_TF_EN 0

# AUX
param set-default PWM_AUX_DIS1 1500
param set-default PWM_AUX_DIS2 1500
param set-default PWM_AUX_FUNC1 201
param set-default PWM_AUX_FUNC2 202
param set-default PWM_AUX_FUNC5 101
param set-default PWM_AUX_TIM0 50

# POWER
# Cruise current of one pack, seeds the remaining-time estimate.
param set-default BAT_AVRG_CURRENT 5
param set-default BAT_CRIT_THR 0.15
param set-default BAT_EMERGEN_THR 0.08
param set-default BAT_LOW_THR 0.25
# 6S Li-ion packs, 4500 mAh each.
param set-default BAT1_CAPACITY 4500
param set-default BAT1_N_CELLS 6
param set-default BAT1_V_CHARGED 4.15
param set-default BAT1_V_EMPTY 3.3
param set-default BAT2_CAPACITY 4500
param set-default BAT2_N_CELLS 6
param set-default BAT2_V_CHARGED 4.15
param set-default BAT2_V_EMPTY 3.3
param set-default BAT2_SOURCE 0
param set-default INA238_SHUNT 0.0001
param set-default SENS_EN_INA226 0
param set-default SENS_EN_INA238 1

# LOGGING
param set-default SDLOG_DIRS_MAX 30
