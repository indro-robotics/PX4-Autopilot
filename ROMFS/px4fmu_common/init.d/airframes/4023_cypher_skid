#!/bin/sh
#
# @name Cypher Skid
#
# @type Quadrotor x
# @class Copter
#
# @maintainer Calvin Rubens <calvin.rubens@indrorobotics.com>
#

. ${R}etc/init.d/rc.mc_defaults

# GEOMETRY
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR1_KM -0.05
param set-default CA_ROTOR2_KM -0.05

# MOTORS
param set-default CA_ROTOR0_PX -0.1
param set-default CA_ROTOR0_PY -0.1
param set-default CA_ROTOR1_PX 0.1
param set-default CA_ROTOR1_PY -0.1
param set-default CA_ROTOR2_PX -0.1
param set-default CA_ROTOR2_PY 0.1
param set-default CA_ROTOR3_PX 0.1
param set-default CA_ROTOR3_PY 0.1
param set-default MOT_POLE_COUNT 12

# COMMS
param set-default SER_TEL2_BAUD 3000000
param set-default MAV_2_CONFIG 0
param set-default UXRCE_DDS_CFG 102
param set-default UXRCE_DDS_DOM_ID 23
param set-default UXRCE_DDS_PTCFG 1
# No GPS: the agent's UTC sets the FMU clock after timesync, so .ulg dates match wall clock.
param set-default UXRCE_DDS_SYNCC 1

# SENSORS
param set-default SYS_HAS_BARO 0
param set-default SYS_HAS_GPS 0
param set-default SYS_HAS_MAG 0
param set-default SENS_BOARD_ROT 14

# UAVCAN
param set-default UAVCAN_ENABLE 2
param set-default UAVCAN_SUB_FLOW 1
param set-default UAVCAN_SUB_IMU 1
param set-default UAVCAN_SUB_MAG 0
param set-default UAVCAN_SUB_RNG 1
param set-default UAVCAN_RNG_MAX 50.0
param set-default UAVCAN_RNG_MIN 0.08

# OF
param set-default SENS_FLOW_MAXHGT 25.0
param set-default SENS_FLOW_MAXR 7.4
param set-default SENS_FLOW_MINHGT 0.08

# MAG
param set-default CAL_MAG0_PRIO 0

# EKF2
param set-default EKF2_BARO_CTRL 0
param set-default EKF2_EV_CTRL 11
param set-default EKF2_EV_NOISE_MD 1
# cuVSLAM is the only yaw reference; ev_yaw_control.cpp squares this, so 0.02 rad is 1.1 deg one-sigma.
param set-default EKF2_EVA_NOISE 0.02
# Matches EKF2_EVP_GATE: a rejected yaw sample leaves yaw on the gyro.
param set-default EKF2_HDG_GATE 5.0
param set-default EKF2_GPS_CTRL 0
param set-default EKF2_HGT_REF 3
# No magnetometer on this airframe: explicit NONE, never auto.
param set-default EKF2_MAG_TYPE 5
param set-default EKF2_RNG_K_GATE 1.0
param set-default EKF2_RNG_A_HMAX 10.0

# IMU
param set-default EKF2_IMU_POS_X 0.042523
param set-default EKF2_IMU_POS_Y -0.031
param set-default EKF2_IMU_POS_Z -0.096939

# OF
param set-default EKF2_OF_CTRL 1
param set-default EKF2_OF_POS_X -0.0058
param set-default EKF2_OF_POS_Y -0.0035
param set-default EKF2_OF_POS_Z 0.008215
# The PAA3905 peaks near 112 on this floor, so a threshold of 100 rejects flow almost always.
param set-default EKF2_OF_QMIN 60
param set-default EKF2_OF_QMIN_GND 40

# RNG
# Unconditional range aiding keeps a height source on an EV dropout, so Descend and Land stay runnable.
param set-default EKF2_RNG_CTRL 2
# De-weights range against EV on the height state, so an AMR deck step moves height by centimetres.
param set-default EKF2_RNG_NOISE 0.5
# Indoor shelf passes drop the median range far enough to trip the multicopter fog block.
param set-default EKF2_RNG_FOG 0
param set-default EKF2_MIN_RNG 0.1
param set-default EKF2_RNG_POS_X -0.001622
param set-default EKF2_RNG_POS_Y -0.01792
param set-default EKF2_RNG_POS_Z 0.010135

# COM
param set-default COM_FLTMODE1 2
param set-default COM_FLTMODE4 2
param set-default COM_FLTMODE6 2
param set-default COM_DISARM_LAND 1.0
# No SD card, no ULog: arming refuses until the card is mounted.
param set-default COM_ARM_SDCARD 2
param set-default COM_FLTT_LOW_ACT 1
param set-default COM_HOME_EN 0
param set-default COM_LOW_BAT_ACT 2
param set-default COM_OBL_RC_ACT 4
param set-default COM_OF_LOSS_T 5.0
param set-default COM_RC_IN_MODE 0
param set-default COM_RC_LOSS_T 2.0
param set-default COM_RC_OVERRIDE 3
param set-default COM_RC_STICK_OV 20.0
param set-default COM_QC_ACT 1
param set-default GF_ACTION 5
param set-default MAN_ARM_GESTURE 0
param set-default NAV_RCL_ACT 3
param set-default RTL_DESCEND_ALT 3.0
param set-default RTL_RETURN_ALT 3.0

# RC
param set-default RC_CHAN_CNT 16
# The CRSF driver has no default port: without this no RC driver starts.
param set-default RC_CRSF_PRT_CFG 300
param set-default RC_MAP_ARM_SW 5
param set-default RC_MAP_FLTMODE 6
param set-default RC_MAP_KILL_SW 8
param set-default RC_MAP_PITCH 3
param set-default RC_MAP_ROLL 2
param set-default RC_MAP_THROTTLE 1
param set-default RC_MAP_YAW 4

# AUTO
param set-default MIS_TAKEOFF_ALT 1.0

# MPC
# Terrain hold (2) climbs a hands-off hover when an AMR passes underneath.
param set-default MPC_ALT_MODE 0
param set-default MPC_LAND_ALT3 0.4
# Above MPC_LAND_SPEED below MPC_LAND_ALT3: a slower final descent floats in ground effect.
param set-default MPC_LAND_CRWL 3.0
param set-default MPC_LAND_RC_HELP 1
param set-default MPC_LAND_SPEED 0.7
param set-default MPC_THR_HOVER 0.35
param set-default MPC_TKO_RAMP_T 0.5
param set-default MPC_TKO_SPEED 1.5

# AUX
param set-default PWM_AUX_FUNC1 101
param set-default PWM_AUX_FUNC2 102
param set-default PWM_AUX_FUNC3 103
param set-default PWM_AUX_FUNC4 104
param set-default PWM_AUX_TIM0 -3

# POWER
param set-default BAT1_CAPACITY -1
param set-default BAT1_N_CELLS 6
param set-default BAT1_R_INTERNAL 0.007
param set-default BAT1_SOURCE 0
param set-default BAT1_V_CHARGED 4.2
# Li-ion cells, not LiPo: 2.8 V per cell under load is the empty point for this chemistry.
param set-default BAT1_V_EMPTY 2.8
param set-default BAT2_CAPACITY -1
param set-default BAT2_N_CELLS 1
param set-default BAT2_R_INTERNAL 0.007
param set-default BAT2_SOURCE 0
param set-default BAT2_V_CHARGED 25.2
param set-default BAT2_V_EMPTY 16.8

# POWER MODULE
param set-default SENS_EN_INA226 0
param set-default SENS_EN_INA238 1
param set-default INA238_SHUNT 0.0001

# LOGGING
# 30 dated directories is 30 flying days, and this 62 GB card holds that at up to 2 GB a day.
param set-default SDLOG_DIRS_MAX 30
